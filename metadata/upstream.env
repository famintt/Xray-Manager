# 下载源依次尝试（首个成功即停，SHA256 校验不因换源放松）。
XRAY_MIRROR_BASE="https://github.com/${REPO_OWNER:-famintt}/${REPO_NAME:-Xray-Manager}/releases/download/upgrade-mirror"

# cloudflared 仅 Argo 使用，沿用 sbm 的完整校验逻辑。
